{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/resume", "destination": "https://drive.google.com/file/d/1NIzDxWZWDqUEr56z9fVl5rMb8POS7CdZ/view?usp=sharing", "permanent": false },

    { "source": "/projects.html", "destination": "/#case-studies", "permanent": true },
    { "source": "/projects", "destination": "/#case-studies", "permanent": true },

    { "source": "/experience.html", "destination": "/about", "permanent": true },
    { "source": "/experience", "destination": "/about", "permanent": true },

    { "source": "/project-viewer.html", "has": [{ "type": "query", "key": "project", "value": "netflix" }], "destination": "/case/netflix", "permanent": true },
    { "source": "/project-viewer.html", "has": [{ "type": "query", "key": "project", "value": "amazon" }], "destination": "/case/amazon-prime", "permanent": true },
    { "source": "/project-viewer.html", "has": [{ "type": "query", "key": "project", "value": "jupiter" }], "destination": "/#case-studies", "permanent": true },
    { "source": "/project-viewer.html", "destination": "/#case-studies", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    },
    {
      "source": "/Assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    }
  ]
}
